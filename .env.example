# Copy to .env and fill in values. .env is gitignored.

# ruby_llm — set whichever providers you actually use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Features API workflow (see CLAUDE.md → "Feature Workflow")
# Get the token from Production Admin → Users → Your User → Copy API Token
STARTER_API_TOKEN=
STARTER_API_URL=

# CORS — comma-separated list of allowed origins for /api/v1/*.
# Leave empty / unset in development to allow all origins; set explicitly in prod.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Dokku deploy (optional)
DOKKU_HOST=
DOKKU_USER=
DOKKU_PASSWORD=

# Internal logs + notifications (replaces Rollbar — see CLAUDE.md → "Error logging")
# Slack incoming webhook for system alerts (SlackService.system_alert_service).
# Per-log notification channels are managed in Admin → Logs → Notifications.
SLACK_WEBHOOK_URL=
# From address for outgoing mail (log alerts, welcome emails, campaigns)
MAIL_FROM=
# Shown in notification subjects / Slack messages
APP_NAME=Starter
# NimbleHQ's public feed for this product (/whats-new and its footer link); blank hides both
WHATS_NEW_FEED_URL=

# Bot protection — reCAPTCHA Enterprise (see CLAUDE.md → "Bot protection").
# Leave blank to disable: the widget is not rendered and verification is skipped.
RECAPTCHA_SITE_KEY=
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_ENTERPRISE_PROJECT_ID=

# Sign in with Google (see CLAUDE.md → "Sign in with Google").
# Leave blank to disable: the button is not rendered and the strategy is not registered.
# Authorized redirect URI: https://<your-host>/users/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
