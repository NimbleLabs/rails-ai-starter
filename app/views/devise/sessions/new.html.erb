<% input_class = "input-form-field" %>

<section class="min-h-[80vh] flex items-center justify-center px-4 py-12 bg-primary/5">
  <div class="w-full max-w-md">
    <div class="text-center mb-6">
      <span class="brand-mark w-14 h-14 text-xl">ST</span>
      <h1 class="mt-4 text-3xl text-ink">Welcome back</h1>
      <p class="mt-1 text-ink-muted">Sign in to Starter</p>
    </div>

    <div class="card space-y-4">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div>
          <%= f.label :email, "Email address", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: input_class %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <%= f.label :password, class: "form-label mb-0" %>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm font-semibold text-primary hover:text-primary-hover" %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", class: input_class %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2 text-sm text-ink">
            <%= f.check_box :remember_me, class: "form-checkbox" %>
            Remember me
          </label>
        <% end %>

        <%= f.submit "Log in", class: "btn-primary w-full text-base cursor-pointer" %>
      <% end %>
    </div>

    <p class="mt-6 text-center text-sm text-ink-muted">
      Not a member?
      <%= link_to "Sign up", new_registration_path(resource_name), class: "font-semibold text-primary hover:text-primary-hover" %>
    </p>
  </div>
</section>
