<% link_class = "font-semibold text-primary hover:text-primary-hover" %>
<div class="mt-6 text-center text-sm text-ink-muted space-y-1">
  <%- if controller_name != 'sessions' %>
    <p>Already have an account? <%= link_to "Log in", new_session_path(resource_name), class: link_class %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p>New here? <%= link_to "Sign up", new_registration_path(resource_name), class: link_class %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: link_class %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: link_class %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), class: link_class %></p>
  <% end %>

</div>
