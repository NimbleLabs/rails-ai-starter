<% input_class = "input-form-field" %>

<section class="min-h-[80vh] flex items-center justify-center px-4 py-12 bg-primary/5">
  <div class="w-full max-w-md">
    <div class="text-center mb-6">
      <span class="brand-mark w-14 h-14 text-xl">ST</span>
      <h1 class="mt-4 text-3xl text-ink">Create your account</h1>
      <p class="mt-1 text-ink-muted">Start building in seconds.</p>
    </div>

    <div class="card space-y-4">
      <%= render "devise/shared/google_button" %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, autofocus: true, class: input_class %>
        </div>

        <div>
          <%= f.label :email, "Email address", class: "form-label" %>
          <%= f.email_field :email, class: input_class %>
        </div>

        <div>
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: input_class %>
        </div>

        <%= render "shared/recaptcha", action: "signup" %>

        <%= f.submit "Sign up", class: "btn-primary w-full text-base cursor-pointer" %>
      <% end %>
    </div>

    <p class="mt-6 text-center text-sm text-ink-muted">
      Already a member?
      <%= link_to "Sign in", new_session_path(resource_name), class: "font-semibold text-primary hover:text-primary-hover" %>
    </p>
  </div>
</section>
