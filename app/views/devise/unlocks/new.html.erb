<% input_class = "input-form-field" %>

<section class="min-h-[80vh] flex items-center justify-center px-4 py-12 bg-primary/5">
  <div class="w-full max-w-md">
    <div class="text-center mb-6">
      <span class="brand-mark w-14 h-14 text-xl">ST</span>
      <h1 class="mt-4 text-3xl text-ink">Resend unlock instructions</h1>
      <p class="mt-1 text-ink-muted">Enter your email and we'll send a new unlock link.</p>
    </div>

    <div class="card space-y-4">
      <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Email address", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: input_class %>
        </div>

        <%= f.submit "Resend unlock instructions", class: "btn-primary w-full text-base cursor-pointer" %>
      <% end %>
    </div>

    <%= render "devise/shared/links" %>
  </div>
</section>
