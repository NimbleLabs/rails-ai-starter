<% input_class = "input-form-field" %>

<section class="min-h-[80vh] flex items-center justify-center px-4 py-12 bg-primary/5">
  <div class="w-full max-w-md">
    <div class="text-center mb-6">
      <span class="brand-mark w-14 h-14 text-xl">ST</span>
      <h1 class="mt-4 text-3xl text-ink">Change your password</h1>
      <p class="mt-1 text-ink-muted">Pick something strong and memorable.</p>
    </div>

    <div class="card space-y-4">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div>
          <%= f.label :password, "New password", class: "form-label" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: input_class %>
          <% if @minimum_password_length %>
            <p class="form-hint"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input_class %>
        </div>

        <%= f.submit "Change my password", class: "btn-primary w-full text-base cursor-pointer" %>
      <% end %>
    </div>

    <%= render "devise/shared/links" %>
  </div>
</section>
