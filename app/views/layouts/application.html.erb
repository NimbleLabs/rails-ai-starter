<!DOCTYPE html>
<html lang="en" x-data="initAlpineState()" x-bind:class="dark ? 'dark' : ''">
  <head>
    <title><%= content_for(:title) || "Rails Ai Starter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">
    <%= stylesheet_link_tag :app %>

    <% if action_name == 'new' || action_name == 'edit' %>
      <style>
          h1 {
              font-weight: 800;
              letter-spacing: -.025em;
              font-size: 2.25rem;
          }

          trix-editor {
              min-height: 400px !important;
              max-height: 600px !important;
              overflow-y: auto;
          }

          .dark .trix-button--icon {
              -webkit-filter: invert(100%);
          }
      </style>
    <% end %>


    <script>window.__themes = <%= raw themes_json %>;</script>
    <script>
        var radiusMap = { none: '0', sm: '0.25rem', md: '0.375rem', lg: '0.5rem', xl: '0.75rem', full: '9999px' };
        var shadowMap = {
            none: 'none',
            sm: '0 1px 2px 0 rgb(0 0 0 / 0.05)',
            md: '0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)',
            lg: '0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)',
            xl: '0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)'
        };

        function initAlpineState() {
            return {
                open: false,
                dark: localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches),
                theme: localStorage.colorTheme || '<%= default_theme_slug %>',
                themes: window.__themes || [],
                init() {
                    this.applyTheme();
                },
                toggleDarkMode(isDark) {
                    this.dark = isDark;
                    localStorage.theme = isDark ? 'dark' : 'light';
                    this.applyTheme();
                },
                setTheme(slug) {
                    this.theme = slug;
                    localStorage.colorTheme = slug;
                    this.applyTheme();
                },
                applyTheme() {
                    var themes = window.__themes || [];
                    var t = themes.find(function(th) { return th.slug === this.theme; }.bind(this)) || themes[0];
                    if (!t) return;
                    var colors = this.dark ? t.darkMode : t.lightMode;
                    var s = document.documentElement.style;
                    s.setProperty('--theme-primary', colors.primary);
                    s.setProperty('--theme-secondary', colors.secondary);
                    s.setProperty('--theme-accent', colors.accent);
                    s.setProperty('--theme-background', colors.background);
                    s.setProperty('--theme-surface', colors.surface);
                    s.setProperty('--theme-text', colors.text);
                    s.setProperty('--theme-text-muted', colors.textMuted);
                    s.setProperty('--theme-display-font', "'" + t.displayFont + "', system-ui, sans-serif");
                    s.setProperty('--theme-body-font', "'" + t.bodyFont + "', system-ui, sans-serif");
                    s.setProperty('--theme-border-radius', radiusMap[t.borderRadius] || '0.5rem');
                    s.setProperty('--theme-shadow', shadowMap[t.shadow] || shadowMap.md);
                    this.loadThemeFonts(t);
                },
                loadThemeFonts(t) {
                    var id = 'theme-fonts-' + t.slug;
                    if (!document.getElementById(id)) {
                        var link = document.createElement('link');
                        link.id = id;
                        link.rel = 'stylesheet';
                        var displayWeight = t.displayWeight === 'bold' ? '700' : '400';
                        var bodyWeight = t.bodyWeight === 'bold' ? '700' : '400';
                        link.href = 'https://fonts.googleapis.com/css2?family=' +
                            encodeURIComponent(t.displayFont) + ':wght@' + displayWeight +
                            '&family=' + encodeURIComponent(t.bodyFont) + ':wght@' + bodyWeight +
                            '&display=swap';
                        document.head.appendChild(link);
                    }
                }
            };
        }
    </script>

    <script src="//unpkg.com/alpinejs" defer></script>

    <%= javascript_importmap_tags %>
  </head>

  <body x-cloak class="body-base">
    <%= render "shared/nav" %>
    <main>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
