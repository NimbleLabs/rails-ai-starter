<!DOCTYPE html>
<html lang="en" x-data="initAlpineState()" x-bind:class="dark ? 'dark' : ''" x-bind:data-theme="theme">
  <head>
    <title><%= content_for(:title) || "Rails Ai Starter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">
    <%= stylesheet_link_tag :app %>

    <% if action_name == 'new' || action_name == 'edit' %>
      <style>
          h1 {
              font-weight: 800;
              letter-spacing: -.025em;
              font-size: 2.25rem;
          }

          trix-editor {
              min-height: 400px !important;
              max-height: 600px !important;
              overflow-y: auto;
          }

          .dark .trix-button--icon {
              -webkit-filter: invert(100%);
          }
      </style>
    <% end %>


    <script>
        function initAlpineState() {
            return {
                open: false,
                dark: localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches),
                theme: localStorage.colorTheme || 'purple',
                init() {
                    // Apply the theme on initialization
                    this.applyTheme();
                },
                toggleDarkMode(isDark) {
                    console.log("toggleDarkMode isDark:", isDark);
                    this.dark = isDark;
                    localStorage.theme = isDark ? 'dark' : 'light';
                },
                setTheme(name) {
                    console.log("Setting theme to:", name);
                    this.theme = name;
                    localStorage.colorTheme = name;
                    this.applyTheme();
                },
                applyTheme() {
                    // Remove all theme data attributes
                    document.documentElement.removeAttribute('data-theme');

                    // Apply the selected theme (if not purple, which is the default)
                    if (this.theme !== 'purple') {
                        document.documentElement.setAttribute('data-theme', this.theme);
                    }
                }
            };
        }
    </script>

    <script src="//unpkg.com/alpinejs" defer></script>

    <%= javascript_importmap_tags %>
  </head>

  <body x-cloak class="body-base">
    <%= render "shared/nav" %>
    <main>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
