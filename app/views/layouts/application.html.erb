<!DOCTYPE html>
<html lang="en" x-data="initAlpineState()" x-bind:class="dark ? 'dark' : ''">
  <head>
    <title><%= content_for(:title) || app_config.name %></title>
    <meta name="description" content="<%= content_for(:description) || app_config.tagline %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">
    <%= stylesheet_link_tag :app %>
    <%= render "shared/theme_head" %>

    <% if action_name == 'new' || action_name == 'edit' %>
      <style>
          trix-editor {
              min-height: 400px !important;
              max-height: 600px !important;
              overflow-y: auto;
          }

          .dark .trix-button--icon {
              -webkit-filter: invert(100%);
          }
      </style>
    <% end %>

    <% if Ahoy.api %>
      <script src="https://cdn.jsdelivr.net/npm/ahoy.js@0.4.2/dist/ahoy.min.js"></script>
      <script>ahoy.configure({ visitsUrl: "/ahoy/visits", eventsUrl: "/ahoy/events", platform: "Web", useBeacon: true, startOnReady: true, trackVisits: true, cookies: true, visitDuration: 30, visitorDuration: 2 * 365 * 24 * 60 }); ahoy.trackView(); window.ahoy = ahoy;</script>
    <% end %>

    <script>
        function initAlpineState() {
            return {
                open: false,
                dark: localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches),
                toggleDarkMode(isDark) {
                    this.dark = isDark;
                    localStorage.theme = isDark ? 'dark' : 'light';
                }
            };
        }
    </script>

    <script src="//unpkg.com/alpinejs" defer></script>

    <%= javascript_importmap_tags %>
  </head>

  <body x-cloak class="min-h-screen flex flex-col">
    <%= render "shared/nav" %>

    <% if flash.any? %>
      <div class="max-w-7xl mx-auto w-full px-6 mt-4 space-y-2">
        <% flash.each do |type, msg| %>
          <% next if msg.blank? %>
          <div class="<%= case type.to_s when 'notice' then 'alert-success' when 'alert' then 'alert-error' else 'alert-info' end %>" role="status"><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
