<% content_for(:title) { "#{@funnel.name} - Book a Call" } %>

<div class="max-w-4xl mx-auto px-4 py-16">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Book Your Free Consultation</h1>
    <p class="text-xl text-gray-600">Let's discuss how we can help you achieve your goals</p>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8 max-w-md mx-auto">
    <h2 class="text-2xl font-semibold mb-6 text-center">Schedule a Call</h2>

    <div class="space-y-4">
      <p class="text-gray-600 text-center">Choose a time that works for you and we'll connect to discuss your needs.</p>

      <div class="border rounded-lg p-4 hover:border-purple-500 cursor-pointer transition">
        <p class="font-medium">15-Minute Discovery Call</p>
        <p class="text-sm text-gray-500">Quick introduction and overview</p>
      </div>

      <div class="border rounded-lg p-4 hover:border-purple-500 cursor-pointer transition">
        <p class="font-medium">30-Minute Strategy Session</p>
        <p class="text-sm text-gray-500">In-depth discussion of your goals</p>
      </div>

      <div class="pt-4">
        <%= link_to "Continue to Order", funnel_order_path(@funnel), class: "w-full block text-center bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-lg transition" %>
      </div>
    </div>
  </div>

  <div class="text-center mt-6">
    <%= link_to "Back", funnel_lead_path(@funnel), class: "text-gray-500 hover:text-gray-700" %>
  </div>
</div>
