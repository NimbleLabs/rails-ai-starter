<% content_for(:title) { "#{@funnel.name} - Book a Call" } %>

<div class="max-w-4xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl text-ink mb-4">Book Your Free Consultation</h1>
    <p class="text-xl text-ink-muted">Let's discuss how we can help you achieve your goals</p>
  </div>

  <div class="card max-w-md mx-auto">
    <h2 class="text-2xl text-ink mb-6 text-center">Schedule a Call</h2>

    <div class="space-y-4">
      <p class="text-ink-muted text-center">Choose a time that works for you and we'll connect to discuss your needs.</p>

      <div class="card-border rounded-xl p-4 hover:border-primary cursor-pointer transition-colors">
        <p class="font-medium text-ink">15-Minute Discovery Call</p>
        <p class="text-sm text-ink-muted">Quick introduction and overview</p>
      </div>

      <div class="card-border rounded-xl p-4 hover:border-primary cursor-pointer transition-colors">
        <p class="font-medium text-ink">30-Minute Strategy Session</p>
        <p class="text-sm text-ink-muted">In-depth discussion of your goals</p>
      </div>

      <div class="pt-4">
        <%= link_to "Continue to Order", funnel_order_path(@funnel), class: "btn-primary btn-lg w-full" %>
      </div>
    </div>
  </div>

  <div class="text-center mt-6">
    <%= link_to "Back", funnel_lead_path(@funnel), class: "text-sm text-ink-muted hover:text-primary" %>
  </div>
</div>
