<% content_for(:title) { "#{@funnel.name} - Complete Your Order" } %>

<div class="max-w-4xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl text-ink mb-4">Complete Your Order</h1>
    <p class="text-xl text-ink-muted">You're almost there! Just one more step.</p>
  </div>

  <div class="card max-w-md mx-auto">
    <h2 class="text-2xl text-ink mb-6 text-center">Order Summary</h2>

    <div class="border-b border-line pb-4 mb-4">
      <div class="flex justify-between mb-2">
        <span class="text-ink-muted">Product/Service</span>
        <span class="font-medium text-ink">$99.00</span>
      </div>
      <div class="flex justify-between text-sm text-ink-muted">
        <span>Tax</span>
        <span>$0.00</span>
      </div>
    </div>

    <div class="flex justify-between mb-6">
      <span class="font-semibold text-ink">Total</span>
      <span class="font-bold text-xl text-ink">$99.00</span>
    </div>

    <form class="space-y-4">
      <div>
        <label for="card" class="form-label">Card Number</label>
        <input type="text" id="card" name="card" class="input-form-field" placeholder="4242 4242 4242 4242">
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="expiry" class="form-label">Expiry</label>
          <input type="text" id="expiry" name="expiry" class="input-form-field" placeholder="MM/YY">
        </div>
        <div>
          <label for="cvc" class="form-label">CVC</label>
          <input type="text" id="cvc" name="cvc" class="input-form-field" placeholder="123">
        </div>
      </div>
      <div class="pt-4">
        <%= link_to "Complete Purchase", funnel_order_completed_path(@funnel), class: "btn-primary btn-lg w-full" %>
      </div>
    </form>
  </div>

  <div class="text-center mt-6">
    <%= link_to "Back", funnel_book_call_path(@funnel), class: "text-sm text-ink-muted hover:text-primary" %>
  </div>
</div>
