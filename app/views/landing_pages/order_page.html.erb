<% content_for(:title) { "#{@funnel.name} - Complete Your Order" } %>

<div class="max-w-4xl mx-auto px-4 py-16">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Complete Your Order</h1>
    <p class="text-xl text-gray-600">You're almost there! Just one more step.</p>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8 max-w-md mx-auto">
    <h2 class="text-2xl font-semibold mb-6 text-center">Order Summary</h2>

    <div class="border-b pb-4 mb-4">
      <div class="flex justify-between mb-2">
        <span class="text-gray-600">Product/Service</span>
        <span class="font-medium">$99.00</span>
      </div>
      <div class="flex justify-between text-sm text-gray-500">
        <span>Tax</span>
        <span>$0.00</span>
      </div>
    </div>

    <div class="flex justify-between mb-6">
      <span class="font-semibold">Total</span>
      <span class="font-bold text-xl">$99.00</span>
    </div>

    <form class="space-y-4">
      <div>
        <label for="card" class="block text-sm font-medium text-gray-700 mb-1">Card Number</label>
        <input type="text" id="card" name="card" class="input-form-field" placeholder="4242 4242 4242 4242">
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="expiry" class="block text-sm font-medium text-gray-700 mb-1">Expiry</label>
          <input type="text" id="expiry" name="expiry" class="input-form-field" placeholder="MM/YY">
        </div>
        <div>
          <label for="cvc" class="block text-sm font-medium text-gray-700 mb-1">CVC</label>
          <input type="text" id="cvc" name="cvc" class="input-form-field" placeholder="123">
        </div>
      </div>
      <div class="pt-4">
        <%= link_to "Complete Purchase", funnel_order_completed_path(@funnel), class: "w-full block text-center bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-lg transition" %>
      </div>
    </form>
  </div>

  <div class="text-center mt-6">
    <%= link_to "Back", funnel_book_call_path(@funnel), class: "text-gray-500 hover:text-gray-700" %>
  </div>
</div>
