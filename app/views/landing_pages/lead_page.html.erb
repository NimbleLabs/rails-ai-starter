<% content_for(:title) { "#{@funnel.name} - Get Started" } %>

<div class="max-w-4xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl text-ink mb-4">Welcome to <%= @funnel.name %></h1>
    <p class="text-xl text-ink-muted">Take the first step towards your goals</p>
  </div>

  <div class="card max-w-md mx-auto">
    <h2 class="text-2xl text-ink mb-6 text-center">Get Started Today</h2>

    <form class="space-y-4">
      <div>
        <label for="name" class="form-label">Name</label>
        <input type="text" id="name" name="name" class="input-form-field" placeholder="Your name">
      </div>
      <div>
        <label for="email" class="form-label">Email</label>
        <input type="email" id="email" name="email" class="input-form-field" placeholder="you@example.com">
      </div>
      <div class="pt-4">
        <%= link_to "Continue", funnel_book_call_path(@funnel), class: "btn-primary btn-lg w-full" %>
      </div>
    </form>
  </div>
</div>
