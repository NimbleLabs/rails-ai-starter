<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || app_config.name %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="icon" href="/favicon.png" type="image/png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= render "shared/theme_head" %>
  <% if Rails.env.development? %>
    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
  <% end %>
  <%= vite_javascript_tag 'admin.jsx' %>

  <link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.0.5/dist/trix.css">
  <style>
      trix-editor { min-height: 400px !important; max-height: 600px !important; overflow-y: auto; }
      .dark .trix-button--icon { -webkit-filter: invert(100%); }
  </style>
  <script>
    // Current user for the admin SPA (avoids an extra round trip on boot).
    window.__currentUser = <%= raw({ id: current_user.id, name: current_user.name, email: current_user.email, admin: current_user.admin? }.to_json) %>;
    // config/app.yml's name and brand mark (see AppConfig and ~/lib/app).
    window.__app = <%= raw({ name: app_config.name, shortName: app_config.short_name }.to_json) %>;
  </script>
</head>
<body class="h-screen">
<div id="app" class="h-full"></div>
</body>
</html>
