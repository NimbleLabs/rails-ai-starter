<!DOCTYPE html>
<html>
<head>
  <title>Starter Admin App</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <% if Rails.env.development? %>
    <%= vite_client_tag %>
  <% end %>
  <%= vite_javascript_tag 'admin' %>

  <link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.0.5/dist/trix.css">

  <style>
      h1, h2, h3 {
          font-weight: 800;
          letter-spacing: -.025em;
      }

       h1 {
           font-weight: 800;
           letter-spacing: -.025em;
           font-size: 2.25rem;
       }

      trix-editor {
          min-height: 400px !important;
          max-height: 600px !important;
          overflow-y: auto;
      }

      .dark .trix-button--icon {
          -webkit-filter: invert(100%);
      }
  </style>

</head>
<body class="body-base h-screen">
<div id="app" class="h-full"></div>
</body>
</html>
