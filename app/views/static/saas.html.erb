<!-- CTA Section -->
<section class="section-colored py-24">
  <div class="max-w-4xl mx-auto text-center px-6">
    <h2 class="font-bold text-4xl md:text-6xl text-white mb-6">
      Ready to Get Started?
    </h2>
    <p class="text-xl text-white/90 mb-12 max-w-2xl mx-auto">
      Join thousands of businesses that trust our platform to power their growth
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">

      <% if user_signed_in? %>
        <%= link_to "Open App", app_path, class: "btn btn-accent px-8 py-4 text-lg font-semibold rounded-full shadow-xl hover:shadow-2xl transform hover:scale-105 transition-all duration-300" %>
      <% else %>
        <%= link_to "Get Started Free", new_registration_path(resource_name), class: "btn btn-accent px-8 py-4 text-lg font-semibold rounded-full shadow-xl hover:shadow-2xl transform hover:scale-105 transition-all duration-300" %>
      <% end %>

      <button class="btn px-8 py-4 text-lg font-semibold rounded-full border-2 border-white/30 bg-white/10 hover:bg-white/20 text-white">
        Schedule a Demo
      </button>
    </div>
  </div>
</section>