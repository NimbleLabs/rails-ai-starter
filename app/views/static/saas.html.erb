<!-- Hero Section -->
<section class="section-light min-h-screen flex items-center justify-center relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-secondary/10 dark:from-primary/10 dark:to-secondary/20"></div>
  <div class="relative z-10 text-center px-6 max-w-6xl mx-auto">
    <h1 class="font-extrabold text-5xl md:text-7xl lg:text-8xl tracking-tight mb-8 text-primary">
      Rails AI Starter
    </h1>
    <p class="text-xl md:text-2xl mb-12 max-w-3xl mx-auto leading-relaxed text-ink-muted">
      The modern SaaS platform that transforms your business with cutting-edge AI technology and beautiful user experiences
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <% if user_signed_in? %>
        <%= link_to "Open App", app_path, class: "btn btn-accent px-8 py-4 text-lg font-semibold rounded-full shadow-xl hover:shadow-2xl transform hover:scale-105 transition-all duration-300" %>
      <% else %>
        <%= link_to "Get Started Free", new_registration_path(resource_name), class: "btn btn-accent px-8 py-4 text-lg font-semibold rounded-full shadow-xl hover:shadow-2xl transform hover:scale-105 transition-all duration-300" %>
      <% end %>
      <button class="btn btn-secondary px-8 py-4 text-lg font-semibold rounded-full">
        Watch Demo
      </button>

    </div>
  </div>
</section>

<!-- Features Section -->
<section class="section-neutral py-24">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="font-bold text-4xl md:text-6xl mb-6 text-ink">
        Powerful Features
      </h2>
      <p class="text-xl max-w-3xl mx-auto text-ink-muted">
        Everything you need to build, scale, and grow your SaaS business with confidence
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="card group hover:scale-105 transition-transform duration-300">
        <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mb-4 group-hover:bg-secondary transition-colors">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-ink">Lightning Fast</h3>
        <p class="text-ink-muted">Built with modern technologies for optimal performance and user experience.</p>
      </div>

      <div class="card group hover:scale-105 transition-transform duration-300">
        <div class="w-12 h-12 bg-accent rounded-lg flex items-center justify-center mb-4 group-hover:bg-accent-hover transition-colors">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-ink">Secure by Default</h3>
        <p class="text-ink-muted">Enterprise-grade security measures to protect your data and users.</p>
      </div>

      <div class="card group hover:scale-105 transition-transform duration-300">
        <div class="w-12 h-12 bg-success rounded-lg flex items-center justify-center mb-4 group-hover:bg-success-hover transition-colors">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-ink">User Friendly</h3>
        <p class="text-ink-muted">Intuitive interface designed for both beginners and power users.</p>
      </div>
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="section-light py-24">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-8 text-center">
      <div class="space-y-2">
        <div class="text-4xl md:text-5xl font-bold text-primary">10k+</div>
        <div class="text-lg text-ink-muted">Active Users</div>
      </div>
      <div class="space-y-2">
        <div class="text-4xl md:text-5xl font-bold text-accent">99.9%</div>
        <div class="text-lg text-ink-muted">Uptime</div>
      </div>
      <div class="space-y-2">
        <div class="text-4xl md:text-5xl font-bold text-success">500+</div>
        <div class="text-lg text-ink-muted">Companies</div>
