<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || app_config.name %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="icon" href="/favicon.png" type="image/png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= render "shared/theme_head" %>
  <% if Rails.env.development? %>
    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
  <% end %>
  <%= vite_javascript_tag 'application.jsx' %>
  <script>
    window.__currentUser = <%= raw({ id: current_user.id, name: current_user.name, email: current_user.email, admin: current_user.admin? }.to_json) %>;
    // config/app.yml's name and brand mark (see AppConfig and ~/lib/app).
    window.__app = <%= raw({ name: app_config.name, shortName: app_config.short_name }.to_json) %>;
  </script>
</head>
<body class="h-screen">
<div id="app" class="h-full"></div>
</body>
</html>
