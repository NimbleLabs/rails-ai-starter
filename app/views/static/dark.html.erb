<%# Alternate landing routed at /dark-theme. Same hero pattern as the homepage,
    rendered on the runtime tokens so it follows the active theme / dark mode. %>
<section class="py-24 md:py-32">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <p class="eyebrow mb-4">Dark theme</p>
    <h1 class="text-ink text-4xl md:text-6xl leading-tight mb-6">
      Powerful Features
    </h1>
    <p class="text-lg md:text-xl text-ink-muted mb-10">
      Everything you need to build, scale, and grow your SaaS business with confidence
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <button type="button" @click="toggleDarkMode(!dark)" class="btn-primary btn-lg">
        <span x-show="!dark">Switch to dark mode</span>
        <span x-show="dark" x-cloak>Switch to light mode</span>
      </button>
      <%= link_to "Back home", root_path, class: "btn-secondary btn-lg" %>
    </div>
  </div>
</section>

<section class="py-20 bg-primary/10">
  <div class="max-w-6xl mx-auto px-6">
    <div class="card flex items-center gap-4">
      <div class="p-4 inline-flex shrink-0 rounded-full bg-primary/10">
        <div class="size-4 rounded bg-primary"></div>
      </div>
      <div>
        <p class="text-ink-muted">
          <span class="font-medium text-ink">Tom Watson</span> mentioned you in
          <span class="font-medium text-ink">Logo redesign</span>
        </p>
        <time class="mt-1 block text-sm text-ink-muted" datetime="9:37">9:37am</time>
      </div>
    </div>
  </div>
</section>
