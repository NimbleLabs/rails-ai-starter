<%# The OAuth consent page: an MCP client (Claude, say) asks to act for the signed-in user. %>
<% client_name = @pre_auth.client.name %>
<% content_for(:title) { "Connect #{client_name} · #{app_config.name}" } %>

<section class="min-h-[80vh] flex items-center justify-center px-4 py-12 bg-primary/5">
  <div class="w-full max-w-md">
    <div class="text-center mb-6">
      <div class="flex items-center justify-center gap-3" aria-hidden="true">
        <span class="inline-flex w-14 h-14 items-center justify-center rounded-control bg-surface border border-line text-ink font-display text-xl font-extrabold shadow-pill">
          <%= client_name.first.upcase %>
        </span>
        <svg class="w-6 h-6 text-ink-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
        </svg>
        <%= brand_mark "w-14 h-14 text-xl" %>
      </div>
      <h1 class="mt-5 text-2xl sm:text-3xl text-ink break-words">Connect <%= client_name %> to <%= app_config.name %>?</h1>
      <p class="mt-2 text-ink-muted break-words">
        Signed in as <span class="font-semibold text-ink"><%= current_user.email %></span>
      </p>
    </div>

    <div class="card space-y-5">
      <div>
        <p class="eyebrow break-words"><%= client_name %> will be able to</p>
        <ul class="mt-3 space-y-3">
          <% @pre_auth.scopes.each do |scope| %>
            <li class="flex gap-3 text-ink">
              <svg class="mt-0.5 w-5 h-5 shrink-0 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              <span><%= t(scope, scope: %i[doorkeeper scopes], app: app_config.name) %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="panel-muted text-sm text-ink-muted space-y-1">
        <p>
          When you allow it, you'll go back to
          <span class="font-semibold text-ink break-all"><%= oauth_redirect_destination(@pre_auth.redirect_uri) %></span>.
        </p>
        <p>Only connect apps you trust.</p>
      </div>

      <%# Turbo stays out of these forms: the response is a redirect to another site. %>
      <div class="flex flex-col-reverse sm:flex-row gap-3">
        <%= form_tag oauth_authorization_path, method: :delete, class: "sm:flex-1", data: { turbo: false } do %>
          <%= render "doorkeeper/authorizations/request_fields" %>
          <%= submit_tag "Cancel", class: "btn-secondary w-full cursor-pointer" %>
        <% end %>
        <%= form_tag oauth_authorization_path, method: :post, class: "sm:flex-1", data: { turbo: false } do %>
          <%= render "doorkeeper/authorizations/request_fields" %>
          <%= submit_tag "Allow", class: "btn-primary w-full cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</section>
