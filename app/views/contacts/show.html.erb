<div class="max-w-3xl mx-auto px-6 py-12">
  <div class="page-header">
    <h1 class="page-title"><%= @contact.name %></h1>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Edit this contact", edit_contact_path(@contact), class: "btn-secondary btn-sm" %>
      <%= link_to "Back to contacts", contacts_path, class: "btn-secondary btn-sm" %>
      <%= button_to "Destroy this contact", @contact, method: :delete, class: "btn-danger btn-sm" %>
    </div>
  </div>

  <%= render @contact %>
</div>
