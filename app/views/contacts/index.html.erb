<% content_for :title, "Contacts" %>

<div class="max-w-7xl mx-auto px-6 py-12 lg:px-8">
  <div class="page-header">
    <h1 class="page-title">Contacts</h1>
    <%= link_to "New contact", new_contact_path, class: "btn-primary" %>
  </div>

  <div id="contacts" class="card-flush overflow-x-auto">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Company</th>
          <th>Budget range</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @contacts.empty? %>
          <tr><td colspan="6" class="empty-state">No contacts yet.</td></tr>
        <% end %>
        <% @contacts.each do |contact| %>
          <tr id="<%= dom_id contact %>">
            <td class="font-medium"><%= contact.name %></td>
            <td class="text-ink-muted"><%= contact.email %></td>
            <td class="text-ink-muted"><%= contact.phone %></td>
            <td class="text-ink-muted"><%= contact.company %></td>
            <td class="text-ink-muted"><%= contact.budget_range %></td>
            <td class="text-right">
              <%= link_to "Show this contact", contact, class: "table-link" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
