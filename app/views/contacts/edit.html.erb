<div class="max-w-2xl mx-auto px-6 py-12">
  <div class="page-header">
    <h1 class="page-title">Editing contact</h1>
    <div class="flex gap-2">
      <%= link_to "Show this contact", @contact, class: "btn-secondary btn-sm" %>
      <%= link_to "Back to contacts", contacts_path, class: "btn-secondary btn-sm" %>
    </div>
  </div>

  <div class="card">
    <%= render "form", contact: @contact %>
  </div>
</div>
