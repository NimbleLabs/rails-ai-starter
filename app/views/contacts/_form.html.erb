<%= form_with(model: contact, class: "space-y-5") do |form| %>
  <% if contact.errors.any? %>
    <div id="error_explanation" class="alert-error">
      <h2 class="font-semibold text-sm mb-1"><%= pluralize(contact.errors.count, "error") %> prohibited this contact from being saved:</h2>

      <ul class="list-disc list-inside space-y-0.5">
        <% contact.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :email, class: "form-label" %>
    <%= form.text_field :email, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :phone, class: "form-label" %>
    <%= form.text_field :phone, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :company, class: "form-label" %>
    <%= form.text_field :company, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :budget_range, class: "form-label" %>
    <%= form.text_field :budget_range, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :message, class: "form-label" %>
    <%= form.text_area :message, rows: 4, class: "input-form-field" %>
  </div>

  <div class="pt-2">
    <%= form.submit 'Send', class: "btn-primary" %>
  </div>
<% end %>
