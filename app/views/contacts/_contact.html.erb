<div id="<%= dom_id contact %>" class="card grid grid-cols-1 sm:grid-cols-2 gap-5">
  <div>
    <p class="stat-label">Name</p>
    <p class="text-ink font-medium"><%= contact.name %></p>
  </div>

  <div>
    <p class="stat-label">Email</p>
    <p class="text-ink"><%= contact.email %></p>
  </div>

  <div>
    <p class="stat-label">Phone</p>
    <p class="text-ink"><%= contact.phone %></p>
  </div>

  <div>
    <p class="stat-label">Company</p>
    <p class="text-ink"><%= contact.company %></p>
  </div>

  <div>
    <p class="stat-label">Budget range</p>
    <p class="text-ink"><%= contact.budget_range %></p>
  </div>

  <div class="sm:col-span-2">
    <p class="stat-label">Message</p>
    <p class="text-ink leading-relaxed whitespace-pre-line"><%= contact.message %></p>
  </div>
</div>
