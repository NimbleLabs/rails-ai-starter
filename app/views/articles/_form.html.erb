<%= form_with(model: article, class: "space-y-5") do |form| %>
  <% if article.errors.any? %>
    <div id="error_explanation" class="alert-error">
      <h2 class="font-semibold text-sm mb-1"><%= pluralize(article.errors.count, "error") %> prohibited this article from being saved:</h2>

      <ul class="list-disc list-inside space-y-0.5">
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :description, class: "form-label" %>
    <%= form.text_field :description, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :content, class: "form-label" %>
    <%= form.rich_text_area :content %>
  </div>

  <div>
    <%= form.label :author, class: "form-label" %>
    <%= form.text_field :author, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :category, class: "form-label" %>
    <%= form.text_field :category, class: "input-form-field" %>
  </div>

  <div class="flex items-center gap-6">
    <label class="flex items-center gap-2 text-sm text-ink">
      <%= form.check_box :published, class: "form-checkbox" %>
      <%= form.label :published, class: "cursor-pointer" %>
    </label>

    <label class="flex items-center gap-2 text-sm text-ink">
      <%= form.check_box :featured, class: "form-checkbox" %>
      <%= form.label :featured, class: "cursor-pointer" %>
    </label>
  </div>

  <div>
    <%= form.label :published_at, class: "form-label" %>
    <%= form.datetime_field :published_at, class: "input-form-field" %>
  </div>

  <div>
    <%= form.label :featured_image, class: "form-label" %>
    <%= form.file_field :featured_image, class: "block w-full text-sm text-ink-muted file:mr-4 file:rounded-xl file:border file:border-line file:bg-surface file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-ink file:cursor-pointer" %>
  </div>

  <div class="pt-2">
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
