<% content_for :title, "Articles" %>

<div class="max-w-7xl mx-auto px-6 py-12 lg:px-8">
  <div class="page-header">
    <div>
      <p class="eyebrow mb-2">Blog</p>
      <h1 class="page-title">Articles</h1>
    </div>
    <% if user_signed_in? && current_user.admin? %>
      <%= link_to "New article", new_article_path, class: "btn-primary" %>
    <% end %>
  </div>

  <% if @articles.empty? %>
    <div class="card empty-state">No articles yet.</div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @articles.each do |article| %>
        <%= link_to article_path(article), class: "card-flush flex flex-col hover:shadow-lg transition-shadow duration-200" do %>
          <!-- Featured Image -->
          <div class="aspect-w-16 aspect-h-9">
            <% if article.featured_image.attached? %>
              <%= image_tag article.featured_image,
                            class: "w-full h-48 object-cover",
                            alt: article.title %>
            <% else %>
              <div class="w-full h-48 bg-gradient-to-r from-primary to-brand-800"></div>
            <% end %>
          </div>

          <!-- Content -->
          <div class="p-5 flex-1 flex flex-col">
            <!-- Status Badge -->
            <div class="mb-3">
              <span class="<%= article.published? ? 'badge-green' : 'badge-gray' %>">
                <%= article.published? ? 'Published' : 'Draft' %>
              </span>
            </div>

            <!-- Title -->
            <h2 class="text-xl text-ink mb-2 line-clamp-2">
              <%= article.title %>
            </h2>

            <!-- Description -->
            <p class="text-sm text-ink-muted mb-4 line-clamp-2">
              <%= article.description %>
            </p>

            <!-- Metadata -->
            <div class="mt-auto flex flex-col gap-1 text-sm text-ink-muted">
              <div class="flex items-center">
                <svg class="h-4 w-4 mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <%= article.author || "Anonymous" %>
              </div>

              <time datetime="<%= article.created_at.iso8601 %>">
                <%= article.created_at.strftime("%B %d, %Y") %>
              </time>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
