<article>
  <!-- Hero Section with Featured Image -->
  <div class="relative h-[400px] mb-8">
    <% if @article.featured_image.attached? %>
      <%= image_tag @article.featured_image,
          class: "w-full h-full object-cover brightness-50",
          alt: @article.title %>
    <% else %>
      <div class="w-full h-full bg-gradient-to-r from-primary to-brand-800"></div>
    <% end %>

    <!-- Overlay Title -->
    <div class="absolute inset-0 flex items-center justify-center px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl text-white text-center max-w-4xl">
        <%= @article.title %>
      </h1>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Article Metadata -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-muted mb-6">
        <div class="flex items-center">
          <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <%= @article.author || "Anonymous" %>
        </div>

        <span class="text-line">&bull;</span>

        <div class="flex items-center">
          <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          <%= @article.category %>
        </div>

        <span class="text-line">&bull;</span>

        <time datetime="<%= @article.created_at.iso8601 %>" class="flex items-center">
          <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <%= @article.created_at.strftime("%B %d, %Y") %>
        </time>
      </div>

      <% if @article.description.present? %>
        <p class="text-lg text-ink-muted border-l-4 border-primary pl-4 italic">
          <%= @article.description %>
        </p>
      <% end %>
    </header>

    <!-- Article Content -->
    <div class="text-ink leading-relaxed">
      <%= @article.content %>
    </div>

    <!-- Article Footer -->
    <footer class="mt-8 pt-8 border-t border-line">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-2">
          <% if @article.published? %>
            <span class="badge-green">Published</span>
          <% else %>
            <span class="badge-gray">Draft</span>
          <% end %>
        </div>

        <div class="flex space-x-4 text-sm">
          <% if user_signed_in? && current_user.admin? %>
            <%= link_to "Edit", edit_article_path(@article), class: "font-semibold text-primary hover:text-primary-hover" %>
          <% end %>
          <%= link_to "Back to articles", articles_path, class: "text-ink-muted hover:text-primary" %>
        </div>
      </div>
    </footer>
  </div>
</article>
