<div id="<%= dom_id article %>" class="card space-y-4">
  <div>
    <p class="stat-label">Title</p>
    <p class="text-ink font-medium"><%= article.title %></p>
  </div>

  <div>
    <p class="stat-label">Description</p>
    <p class="text-ink"><%= article.description %></p>
  </div>

  <div>
    <p class="stat-label">Content</p>
    <div class="text-ink leading-relaxed"><%= article.content %></div>
  </div>

  <div>
    <p class="stat-label">Author</p>
    <p class="text-ink"><%= article.author %></p>
  </div>

  <div>
    <p class="stat-label">Category</p>
    <p class="text-ink"><%= article.category %></p>
  </div>

  <div>
    <p class="stat-label">Published</p>
    <p class="text-ink"><%= article.published %></p>
  </div>

  <div>
    <p class="stat-label">Featured</p>
    <p class="text-ink"><%= article.featured %></p>
  </div>

  <div>
    <p class="stat-label">Published at</p>
    <p class="text-ink"><%= article.published_at %></p>
  </div>
</div>
