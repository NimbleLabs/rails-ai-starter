<%# Mirrors the FitnessHQ footer: a brand column + three link columns
    (Product / Company / Legal) over a copyright bar. On-token (ink / line / primary). %>
<% footer_link = "block text-sm text-ink-muted hover:text-primary transition-colors" %>
<% footer_head = "text-sm font-semibold uppercase tracking-wider text-ink" %>

<footer class="border-t border-line bg-canvas py-16 mt-12">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-10 gap-y-10">

      <%# Brand %>
      <div class="col-span-2 md:col-span-1 space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="brand-mark w-9 h-9 text-sm">ST</span>
          <span class="font-display font-bold text-2xl text-ink">Starter</span>
        </a>
        <p class="text-sm text-ink-muted leading-relaxed max-w-xs">
          A Rails 8 API, a React admin, and an Expo mobile app &mdash; wired together so
          you can ship your next product in days, not months.
        </p>
      </div>

      <%# Product %>
      <div class="space-y-3">
        <h4 class="<%= footer_head %>">Product</h4>
        <nav class="space-y-2 flex flex-col">
          <%= link_to "App", app_path, class: footer_link %>
          <%= link_to "Articles", articles_path, class: footer_link %>
          <% unless user_signed_in? %>
            <%= link_to "Sign up", new_user_registration_path, class: footer_link %>
            <%= link_to "Sign in", new_user_session_path, class: footer_link %>
          <% end %>
        </nav>
      </div>

      <%# Company %>
      <div class="space-y-3">
        <h4 class="<%= footer_head %>">Company</h4>
        <nav class="space-y-2 flex flex-col">
          <%= link_to "About", about_path, class: footer_link %>
          <%= link_to "Contact", new_contact_path, class: footer_link %>
        </nav>
      </div>

      <%# Legal %>
      <div class="space-y-3">
        <h4 class="<%= footer_head %>">Legal</h4>
        <nav class="space-y-2 flex flex-col">
          <%= link_to "Privacy", privacy_path, class: footer_link %>
          <%= link_to "Terms", terms_path, class: footer_link %>
        </nav>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-line flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-ink-muted">
        &copy; <%= Date.current.year %> Your Company. All rights reserved.
      </p>

      <%# Theme selector — drives the Alpine runtime theme switcher in the layout. %>
      <div class="flex items-center gap-2">
        <label for="theme-select" class="text-sm text-ink-muted">Theme</label>
        <select
          id="theme-select"
          @change="setTheme($event.target.value)"
          x-model="theme"
          class="input-form-field w-auto py-1.5 text-sm">
          <template x-for="t in themes" :key="t.slug">
            <option :value="t.slug" x-text="t.slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')"></option>
          </template>
        </select>
      </div>
    </div>
  </div>
</footer>
