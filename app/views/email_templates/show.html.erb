<div class="max-w-3xl mx-auto px-6 py-12">
  <div class="page-header">
    <h1 class="page-title"><%= @email_template.subject %></h1>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Edit this email template", edit_email_template_path(@email_template), class: "btn-secondary btn-sm" %>
      <%= link_to "Back to email templates", email_templates_path, class: "btn-secondary btn-sm" %>
      <%= button_to "Destroy this email template", @email_template, method: :delete, class: "btn-danger btn-sm" %>
    </div>
  </div>

  <%= render @email_template %>
</div>
