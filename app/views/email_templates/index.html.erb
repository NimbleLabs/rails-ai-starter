<% content_for :title, "Email templates" %>

<div class="max-w-7xl mx-auto px-6 py-12 lg:px-8">
  <div class="page-header">
    <h1 class="page-title">Email templates</h1>
    <%= link_to "New email template", new_email_template_path, class: "btn-primary" %>
  </div>

  <div id="email_templates" class="card-flush overflow-x-auto">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Send group</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @email_templates.empty? %>
          <tr><td colspan="3" class="empty-state">No email templates yet.</td></tr>
        <% end %>
        <% @email_templates.each do |email_template| %>
          <tr id="<%= dom_id email_template %>">
            <td class="font-medium"><%= email_template.subject %></td>
            <td class="text-ink-muted"><%= email_template.send_group %></td>
            <td class="text-right">
              <%= link_to "Show this email template", email_template, class: "table-link" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
