<div class="max-w-2xl mx-auto px-6 py-12">
  <div class="page-header">
    <h1 class="page-title">Editing email template</h1>
    <div class="flex gap-2">
      <%= link_to "Show this email template", @email_template, class: "btn-secondary btn-sm" %>
      <%= link_to "Back to email templates", email_templates_path, class: "btn-secondary btn-sm" %>
    </div>
  </div>

  <div class="card">
    <%= render "form", email_template: @email_template %>
  </div>
</div>
