<div id="<%= dom_id email_template %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Subject:</strong>
    <%= email_template.subject %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Body:</strong>
    <%= email_template.body %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Send group:</strong>
    <%= email_template.send_group %>
  </p>

</div>
