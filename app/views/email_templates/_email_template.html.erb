<div id="<%= dom_id email_template %>" class="card space-y-5">
  <div>
    <p class="stat-label">Subject</p>
    <p class="text-ink font-medium"><%= email_template.subject %></p>
  </div>

  <div>
    <p class="stat-label">Body</p>
    <div class="text-ink leading-relaxed whitespace-pre-line"><%= email_template.body %></div>
  </div>

  <div>
    <p class="stat-label">Send group</p>
    <p class="text-ink"><%= email_template.send_group %></p>
  </div>
</div>
